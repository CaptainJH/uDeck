---
import { getLocalizedPath, supportedLocales } from '../config/locale'

const fallbackHref = getLocalizedPath('en', '/')
const localeTargets = Object.fromEntries(
  supportedLocales.map((locale) => [locale, getLocalizedPath(locale, '/')]),
)
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Redirecting…</title>
    <noscript>
      <meta http-equiv="refresh" content={`0;url=${fallbackHref}`} />
    </noscript>
    <script
      is:inline
      define:vars={{
        fallbackHref,
        localeTargets,
        supportedLocales,
      }}
    >
      const browserLanguages =
        Array.isArray(navigator.languages) && navigator.languages.length > 0
          ? navigator.languages
          : [navigator.language]

      let targetHref = fallbackHref

      for (const browserLanguage of browserLanguages) {
        const candidate = browserLanguage.toLowerCase().split('-')[0]
        if (supportedLocales.includes(candidate)) {
          targetHref = localeTargets[candidate] ?? fallbackHref
          break
        }
      }

      window.location.replace(targetHref)
    </script>
  </head>
  <body>
    <p>
      Redirecting to
      <a href={fallbackHref}>{fallbackHref}</a>
      ...
    </p>
  </body>
</html>
