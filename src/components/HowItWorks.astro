---
import '../styles/globals.css'
import { defaultLocale, type Locale } from '../config/locale'
import { getSiteConfig } from '../config/site.config'
import LandingSection from './LandingSection.astro'
import SectionHeader from './SectionHeader.astro'
import AppStoreBadge from './AppStoreBadge.astro'
import MacDownloadButton from './MacDownloadButton.astro'
import { revealStaggerTokens } from '../utils/reveal'

interface Props {
  locale?: Locale
}

const { locale = defaultLocale } = Astro.props
const siteConfig = getSiteConfig(locale)
const { howItWorks, hero } = siteConfig
---

<LandingSection class="section ac-section-band--subtle">
  <div class="ac-hiw">
    <SectionHeader
      badge={howItWorks.badge}
      title={howItWorks.title}
      description={howItWorks.description}
    />

    <div class="ac-hiw__grid">
    {howItWorks.steps.map((step, i) => (
      <div class:list={['ac-hiw__item', ...revealStaggerTokens(i)]}>
          <!-- Step badge -->
          <div class="ac-hiw__number-wrap">
            <div class="ac-hiw__number">
              <span class="ac-hiw__step-index">Step {step.number}</span>
            </div>
            {i < howItWorks.steps.length - 1 && (
              <div class="ac-hiw__line" aria-hidden="true"></div>
            )}
          </div>

          <!-- Card -->
          <div class="ac-hiw__card">
            <h3 class="ac-hiw__title">{step.title}</h3>
            <p class="ac-hiw__desc">{step.description}</p>
            <div class="ac-hiw__card-meta">
              {i === 0 ? (
                <AppStoreBadge
                  locale={locale}
                  href={hero.primaryCta.href}
                  class="ac-hiw__download-badge"
                />
              ) : i === 1 ? (
                <MacDownloadButton
                  locale={locale}
                  href={hero.secondaryCta.href}
                  class="ac-hiw__download-badge"
                />
              ) : (
                <div class="ac-hiw__tap-hint" aria-hidden="true">
                  <svg
                    class="ac-hiw__step-icon"
                    viewBox="0 0 41.9141 28.3496"
                    focusable="false"
                  >
                    <path
                      d="M30.4688 6.49414L34.8828 16.7969C35.1953 17.5684 35.4688 18.3984 35.4688 19.3066C35.4688 22.373 33.0762 24.7754 29.7754 24.7754L14.4348 24.7754C14.7945 24.2396 15.0869 23.6567 15.2962 23.0371L29.7754 23.0371C32.1191 23.0371 33.7402 21.6113 33.7402 19.3066C33.7402 17.1973 32.1191 15.5762 29.7754 15.5762L14.0098 15.5762C13.4673 14.8915 12.8105 14.3017 12.0669 13.8379L29.7754 13.8379C30.5176 13.8379 31.2207 14.0039 31.8359 14.2676L28.7988 6.95312C28.3008 5.74219 27.2852 5.12695 25.8984 5.12695L15.6543 5.12695C14.2578 5.12695 13.252 5.74219 12.7441 6.95312L10.2387 12.9759C9.66734 12.7922 9.06753 12.6741 8.44644 12.6368L11.084 6.49414C11.8848 4.58984 13.4863 3.60352 15.5957 3.60352L25.9473 3.60352C28.0664 3.60352 29.668 4.58984 30.4688 6.49414ZM31.2793 19.3066C31.2793 20.1562 30.5762 20.8398 29.7559 20.8398C28.9062 20.8398 28.1934 20.1758 28.1934 19.3066C28.1934 18.4863 28.9062 17.7734 29.7559 17.7734C30.5762 17.7734 31.2793 18.4863 31.2793 19.3066Z"
                      fill="currentColor"
                      fill-opacity="0.85"
                    />
                    <path
                      d="M14.1895 20.4785C14.1895 23.9355 11.2988 26.7871 7.87109 26.7871C4.41406 26.7871 1.55273 23.9551 1.55273 20.4785C1.55273 17.0215 4.41406 14.1602 7.87109 14.1602C11.3379 14.1602 14.1895 17.0117 14.1895 20.4785ZM7.16797 17.207L7.16797 19.7656L4.59961 19.7656C4.17969 19.7656 3.88672 20.0391 3.88672 20.4785C3.88672 20.9082 4.17969 21.1816 4.59961 21.1816L7.16797 21.1816L7.16797 23.75C7.16797 24.1797 7.44141 24.4629 7.87109 24.4629C8.31055 24.4629 8.58398 24.1797 8.58398 23.75L8.58398 21.1816L11.1426 21.1816C11.5625 21.1816 11.8555 20.9082 11.8555 20.4785C11.8555 20.0391 11.5625 19.7656 11.1426 19.7656L8.58398 19.7656L8.58398 17.207C8.58398 16.7871 8.31055 16.4941 7.87109 16.4941C7.44141 16.4941 7.16797 16.7871 7.16797 17.207Z"
                      fill="currentColor"
                      fill-opacity="0.85"
                    />
                  </svg>
                </div>
              )}
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</LandingSection>

<style>
  .ac-hiw {
    display: flex;
    flex-direction: column;
    gap: var(--ac-spacing-16);
    min-width: 0;
  }

  .ac-hiw__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    column-gap: var(--ac-spacing-6);
    row-gap: var(--ac-spacing-8);
    min-width: 0;
  }

  .ac-hiw__item {
    display: flex;
    flex-direction: column;
    gap: var(--ac-spacing-8);
    min-width: 0;
  }

  /* Number badge + connecting line */
  .ac-hiw__number-wrap {
    display: flex;
    align-items: center;
    gap: var(--ac-spacing-2);
  }

  .ac-hiw__number {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 5.75rem;
    min-height: 3.25rem;
    padding: var(--ac-spacing-3) var(--ac-spacing-4);
    border-radius: var(--ac-rounded-full);
    background: var(--ac-gradient-primary);
    box-shadow: 0 0.25rem 1.25rem rgba(var(--ac-primary), 0.28);
    position: relative;
    z-index: 1;
  }

  .ac-hiw__step-index {
    font-size: var(--ac-text-sm);
    font-weight: var(--ac-font-bold);
    line-height: 1;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: rgb(var(--ac-white));
  }

  .ac-hiw__tap-hint {
    display: inline-flex;
    align-items: flex-end;
    height: 3.25rem;
    transform-origin: 19% 72%;
    animation: ac-hiw-tap 2.2s ease-in-out infinite;
  }

  @keyframes ac-hiw-tap {
    0%,
    100% {
      transform: scale(1);
    }

    18% {
      transform: scale(1);
    }

    32% {
      transform: scale(0.92);
    }

    46% {
      transform: scale(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ac-hiw__tap-hint {
      animation: none;
    }
  }

  .ac-hiw__step-icon {
    display: block;
    flex-shrink: 0;
    height: 3.25rem;
    width: auto;
    color: rgb(var(--ac-gray-900));
  }

  :global([data-theme='dark']) .ac-hiw__step-icon {
    color: rgb(var(--ac-white));
  }

  .ac-hiw__line {
    flex: 1;
    height: 0.125rem;
    background: linear-gradient(
      90deg,
      rgba(var(--ac-primary), 0.5) 0%,
      rgba(var(--ac-primary), 0.1) 100%
    );
    border-radius: 0.125rem;
  }

  /* Card */
  .ac-hiw__card {
    flex: 1;
    padding: var(--ac-spacing-6);
    background: var(--ac-bg-subtle);
    border: 0.125rem solid var(--ac-border-color);
    border-radius: var(--ac-rounded-2xl);
    transition: var(--ac-transition);
    box-shadow: var(--ac-shadow-sm);
    display: flex;
    flex-direction: column;
    gap: var(--ac-spacing-4);
  }

  .ac-hiw__card:hover {
    border-color: rgba(var(--ac-primary), 0.35);
    box-shadow: 0 0.5rem 2rem rgba(var(--ac-primary), 0.1);
    transform: translateY(-0.25rem);
  }

  .ac-hiw__title {
    font-size: var(--ac-text-lg);
    font-weight: var(--ac-font-bold);
    color: var(--ac-text);
  }

  .ac-hiw__desc {
    flex: 1;
    font-size: var(--ac-text-sm);
    color: var(--ac-text-muted);
    line-height: var(--ac-leading-relaxed);
  }

  .ac-hiw__card-meta {
    flex-shrink: 0;
    display: flex;
    align-items: flex-end;
    min-height: 3.25rem;
  }

  :global(.ac-hiw__download-badge) {
    max-width: 100%;
    height: 3.25rem;
  }

  @media (max-width: 48rem) {
    .ac-hiw__grid {
      grid-template-columns: 1fr;
      max-width: 30rem;
      align-self: center;
    }

    .ac-hiw__number-wrap {
      flex-direction: column;
      align-items: flex-start;
    }

    .ac-hiw__line {
      display: none;
    }
  }

  @media (min-width: 48.0625rem) and (max-width: 64rem) {
    .ac-hiw__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
