---
import '../styles/globals.css'
import { defaultLocale, type Locale } from '../config/locale'
import { getSiteConfig } from '../config/site.config'
import LandingSection from './LandingSection.astro'
import SectionHeader from './SectionHeader.astro'
import PricingBillingToggle from './PricingBillingToggle.astro'
import PricingCard from './PricingCard.astro'

interface Props {
  locale?: Locale
}

const { locale = defaultLocale } = Astro.props
const siteConfig = getSiteConfig(locale)
const { pricing } = siteConfig
---

<LandingSection id="pricing" class="section ac-section-band--subtle">
  <SectionHeader badge={pricing.badge} title={pricing.title} description={pricing.description}>
    {pricing.toggle && <PricingBillingToggle />}
  </SectionHeader>

  <div class="ac-pricing__grid">
    {pricing.plans.map((plan, i) => <PricingCard plan={plan} index={i} locale={locale} />)}
  </div>
</LandingSection>

<style>
  .ac-pricing__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--ac-spacing-6);
    align-items: start;
    max-width: 50rem;
    margin: 0 auto;
  }

  @media (max-width: 48rem) {
    .ac-pricing__grid {
      grid-template-columns: 1fr;
      max-width: 25rem;
      align-self: center;
    }
  }
</style>
