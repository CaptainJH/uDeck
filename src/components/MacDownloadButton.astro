---
import { macDownloadLabels } from '../data/mac-download-button'
import type { Locale } from '../config/locale'

interface Props {
  locale: Locale
  href: string
  class?: string
}

const { locale, href, class: className } = Astro.props
const labels = macDownloadLabels[locale]
---

<a
  href={href}
  class:list={['ac-mac-download', className]}
  aria-label={labels.ariaLabel}
  download
>
  <svg
    class="ac-mac-download__icon"
    viewBox="0 0 29.9902 25.791"
    aria-hidden="true"
    focusable="false"
  >
    <path
      d="M2.30469 16.0742C1.91406 16.0742 1.72852 15.9082 1.72852 15.4883L1.72852 3.44727C1.72852 2.90039 2.07031 2.55859 2.61719 2.55859L27.0117 2.55859C27.5586 2.55859 27.9004 2.90039 27.9004 3.44727L27.9004 15.4883C27.9004 15.9082 27.7148 16.0742 27.3242 16.0742Z"
      fill="currentColor"
      fill-opacity="0.2125"
    ></path>
    <path
      d="M2.57812 21.4258L27.0508 21.4258C28.6523 21.4258 29.6289 20.4492 29.6289 18.8477L29.6289 3.4082C29.6289 1.80664 28.6523 0.830078 27.0508 0.830078L2.57812 0.830078C0.976562 0.830078 0 1.80664 0 3.4082L0 18.8477C0 20.4492 0.976562 21.4258 2.57812 21.4258ZM2.30469 16.0742C1.91406 16.0742 1.72852 15.9082 1.72852 15.4883L1.72852 3.44727C1.72852 2.90039 2.07031 2.55859 2.61719 2.55859L27.0117 2.55859C27.5586 2.55859 27.9004 2.90039 27.9004 3.44727L27.9004 15.4883C27.9004 15.9082 27.7148 16.0742 27.3242 16.0742ZM10.9082 24.541L18.7207 24.541L18.7207 21.2695L10.9082 21.2695ZM10.7812 25.791L18.8477 25.791C19.3262 25.791 19.7168 25.4102 19.7168 24.9316C19.7168 24.4434 19.3262 24.0527 18.8477 24.0527L10.7812 24.0527C10.3027 24.0527 9.91211 24.4434 9.91211 24.9316C9.91211 25.4102 10.3027 25.791 10.7812 25.791Z"
      fill="currentColor"
      fill-opacity="0.85"
    ></path>
  </svg>
  <span class="ac-mac-download__text">
    <span class="ac-mac-download__supertitle">{labels.supertitle}</span>
    <span class="ac-mac-download__title">{labels.title}</span>
  </span>
</a>

<style>
  .ac-mac-download {
    box-sizing: border-box;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    height: 3.25rem;
    min-width: 9.75rem;
    padding: 0 0.875rem;
    border: 0.0625rem solid #a6a6a6;
    border-radius: 0.5rem;
    background: #000;
    color: #fff;
    text-decoration: none;
    transform: translateZ(0);
    transition: transform 0.3s ease;
  }

  .ac-mac-download:hover {
    transform: translateY(-0.125rem) translateZ(0);
  }

  .ac-mac-download__icon {
    display: block;
    flex-shrink: 0;
    height: 1.5rem;
    width: auto;
  }

  .ac-mac-download__text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    line-height: 1.1;
    white-space: nowrap;
  }

  .ac-mac-download__supertitle {
    font-size: 0.625rem;
    font-weight: var(--ac-font-medium);
    letter-spacing: 0.01em;
  }

  .ac-mac-download__title {
    font-size: 1.125rem;
    font-weight: var(--ac-font-semibold);
    letter-spacing: -0.01em;
  }

  :global([data-theme='dark']) .ac-mac-download {
    background: #fff;
    color: #000;
  }
</style>
